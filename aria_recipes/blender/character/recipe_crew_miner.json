{
  "name": "crew_miner",
  "version": "2.0",
  "description": "The hired miner at a crew rock in Ores & Odds. Built on Blender Studio's stylised male base rather than out of primitives, and dressed by wrapping blanks onto it. Human scale; the Mine stands him at 3.6m (CrewMiner.MetresTall), so scale on import. Faces -Y.",
  "units": "meters",

  "base": {
    "library": "human_base_meshes",
    "object": "GEO-body_male_stylized",
    "as": "Miner_Body",
    "height": 1.80,
    "location": [0, 0, 0]
  },

  "objects": [
    {"id": "vest", "type": "cylinder", "radius": 0.235, "depth": 0.44, "location": [0, 0, 1.24]},
    {"id": "trousers", "type": "cylinder", "radius": 0.205, "depth": 0.90, "location": [0, 0, 0.61]},
    {"id": "boot_l", "type": "cylinder", "radius": 0.105, "depth": 0.30, "location": [-0.095, -0.02, 0.15]},
    {"id": "boot_r", "type": "cylinder", "radius": 0.105, "depth": 0.30, "location": [0.095, -0.02, 0.15]},

    {"id": "hat_crown", "type": "cylinder", "radius": 0.118, "depth": 0.14, "location": [0, 0, 1.80]},
    {"id": "hat_brim", "type": "cylinder", "radius": 0.205, "depth": 0.022, "location": [0, 0, 1.745]},

    {"id": "haft", "type": "cylinder", "radius": 0.028, "depth": 0.85, "location": [0.44, -0.04, 1.265]},
    {"id": "pick_head", "type": "cube", "size": [0.36, 0.085, 0.085], "location": [0.44, -0.04, 1.705]}
  ],

  "modifiers": [
    {"target": "vest", "type": "subdivision", "levels": 4, "apply": true},
    {"target": "trousers", "type": "subdivision", "levels": 4, "apply": true},
    {"target": "boot_l", "type": "subdivision", "levels": 3, "apply": true},
    {"target": "boot_r", "type": "subdivision", "levels": 3, "apply": true},
    {"target": "haft", "type": "smooth_shade"},
    {"target": "hat_crown", "type": "smooth_shade"}
  ],

  "fit": [
    {"object": "vest", "onto": "Miner_Body", "offset": 0.014, "thickness": 0.015},
    {"object": "trousers", "onto": "Miner_Body", "offset": 0.012, "thickness": 0.013},
    {"object": "boot_l", "onto": "Miner_Body", "offset": 0.018, "thickness": 0.016},
