      {"name": "Shin_L",  "head": [-0.09, 0, 0.50], "tail": [-0.09, 0, 0.13], "parent": "Thigh_L", "connect": true},
      {"name": "Foot_L",  "head": [-0.09, 0, 0.13], "tail": [-0.09, -0.16, 0.03], "parent": "Shin_L", "connect": true}
