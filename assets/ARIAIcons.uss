/* Light mode */
.theme-light .icon-run {
    -unity-background-image: url("run.svg");
}
.theme-light .icon-stop {
    -unity-background-image: url("stop.svg");
}
.theme-light .icon-browse {
    -unity-background-image: url("browse.svg");
}
.theme-light .icon-select-project {
    -unity-background-image: url("select_project.svg");
}
.theme-light .icon-settings {
    -unity-background-image: url("settings.svg");
}
.theme-light .icon-folder {
    -unity-background-image: url("folder.svg");
}
.theme-light .icon-unity {
    -unity-background-image: url("unity.svg");
}
.theme-light .icon-refresh {
    -unity-background-image: url("refresh.svg");
}
.theme-light .icon-info {
    -unity-background-image: url("info.svg");
}
.theme-light .icon-warning {
    -unity-background-image: url("warning.svg");
}
.theme-light .icon-error {
    -unity-background-image: url("error.svg");
}
.theme-light .icon-success {
    -unity-background-image: url("success.svg");
}

