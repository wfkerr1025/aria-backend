# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.env

# Node / frontend
node_modules/
dist/
build/

# Logs and runtime
*.log
dev_server.log
dev_backend.log
dev_server.smoke.log

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/

# Docker
*.tar

# ARIA Lite
.aria_cache/
logs/
tmp/
workspace/projects/
dashboard_test.bin

# ARIA Lite memory databases
backend/aria_memory.db
backend/*.db
backend/*.db-*

# Live API keys. Encrypted at rest with a master key that lives on the
# same machine, so committing the ciphertext puts the secret in history
# permanently and reversibly only by rewriting it.
backend/config/module_keys.enc.json

# Runtime state, not configuration: which local model happens to be
# loaded right now. Committing it makes every machine fight over it.
config/local_model_state.json

# The C# launcher's build output and its embedded-browser profile:
# .vs/, bin/, obj/ and WebView2Data/ (Local Storage, Session Storage,
# leveldb). 43MB of generated files and browser state.
AriaLauncher/.vs/
AriaLauncher/**/bin/
AriaLauncher/**/obj/
AriaLauncher/**/WebView2Data/
AriaLauncher/**/*.csproj.user

# ARIA's staging area: proposed edits, not project files.
.aria_staging/

# This installation's plugin state: the paths you typed, the folders
# you chose, and whatever the Unity CLI reported it can do. The shipped
# registry beside it (aria_config/plugins.json) is the committed one.
aria_config/plugins.local.json

# What Ludo.ai has been asked for and what it cost. Machine state, and
# it doubles as the reuse cache.
aria_config/ludo_spend.jsonl
